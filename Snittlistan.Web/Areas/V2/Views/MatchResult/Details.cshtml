@model ResultViewModel

<div class="row">
    <div class="span4">
        @Html.DisplayFor(model => Model.HeaderViewModel, "Header")
        @if (User.IsInRole2(WebsiteRoles.Uk.UkTasks))
        {
            @Html.ActionLink(
                "Redigera resultat",
                "Edit",
                "MatchResultAdmin",
                new { rosterId = Model.HeaderViewModel.RosterId },
                new { @class = "btn" })
        }
    </div>
</div>
<div class="row">
    <div class="span6">
        @Html.DisplayFor(model => Model.ResultReadModel, "ResultSeriesReadModel")
    </div>
</div>
