@model Snittlistan.Web.Areas.V2.Controllers.MatchResultAdminController.RegisterMatchViewModel
@{
    bool isEdit = string.IsNullOrEmpty(Model.RosterViewModel!.Header!.MatchResultId) == false;
}
<div class="well well-small">
    @Html.DisplayFor(x => x.RosterViewModel.Header)
</div>
@using (Html.BeginForm(
    isEdit ? "Edit" : "RegisterMatchEditor",
    "MatchResultAdmin",
    FormMethod.Post,
    new
    {
        @class = " quill-form",
        data_quill_data = new QuillData(
            Html.NameFor(x => x.Model.CommentaryHtml).ToString(),
            Html.NameFor(x => x.Model.Commentary).ToString(),
            "Skriv ett matchreferat...").ToJson()
    }))
{
    @Html.DisplayFor(model => Html.ViewData.ModelState, "ValidationSummary")
    @Html.Hidden("rosterId", Model.RosterViewModel!.Header!.RosterId)
    @Html.EditorFor(x => x.Model, "MatchPostModel", new { PlayerListItems = Model.PlayerListItems })
    <div class="form-actions">
        <button class="btn btn-primary btn-large" type="submit">@(isEdit ? "Spara" : "Registrera")</button>
        @Html.ActionLink("Avbryt", "Index", "MatchResult", null, new { @class = "btn btn-large" })
    </div>
}
