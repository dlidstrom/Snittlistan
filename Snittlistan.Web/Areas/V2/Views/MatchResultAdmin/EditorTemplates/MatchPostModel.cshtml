@model Snittlistan.Web.Areas.V2.Controllers.MatchResultAdminController.RegisterMatchViewModel.PostModel
@{
    var playerListItems = (SelectListItem[])ViewData["PlayerListItems"];
}

<div class="row">
    <div class="span2">
        <div class="control-group">
            <div class="controls">
                @Html.LabelFor(
                    x => x.TeamScore,
                    new
                    {
                        @class = "control-label"
                    })
                @Html.TextBoxFor(
                    x => x.TeamScore,
                    new
                    {
                        @class = "span1",
                        type = "number",
                        pattern = @"\d*",
                        min = "0",
                        max = "20",
                        required = "required",
                        title = "0-20 poäng",
                        placeholder = "0-20"
                    })
            </div>
        </div>
    </div>
    <div class="span2">
        <div class="control-group">
            <div class="controls">
                @Html.LabelFor(
                    x => x.OpponentScore,
                    new
                    {
                        @class = "control-label"
                    })
                @Html.TextBoxFor(
                    x => x.OpponentScore,
                    new
                    {
                        @class = "span1",
                        type = "number",
                        pattern = @"\d*",
                        min = "0",
                        max = "20",
                        required = "required",
                        title = "0-20 poäng",
                        placeholder = "0-20"
                    })
            </div>
        </div>
    </div>
    <div class="span8">
        <div class="control-group">
            <div class="controls">
                @Html.LabelFor(
                    x => x.CommentaryDisplay,
                    new
                    {
                        @class = "control-label"
                    })
                <div data-quill>@Model.CommentaryDisplay</div>
            </div>
            @Html.HiddenFor(x => x.Commentary)
            @Html.HiddenFor(x => x.CommentaryHtml)
        </div>
    </div>
</div>
<div class="row">
    <div class="span12">
        <p>
            Namnen är förifyllda utifrån vilka som anmält sig till matchen. Byt spelare vid behov.
            Rad 9 är reserv - lämna en serie tom för den spelare som satt över, och fyll i reservens
            resultat för den serien istället. Varje serie ska ha resultat för exakt 8 spelare.
            Ange varje spelares bordpoäng (antal serier hen vann sitt bord) i sista kolumnen -
            det avgörs själv vilka bord som bildas och vem som vinner respektive serie.
        </p>
        <table class="table table-condensed table-bordered table-striped">
            <tr>
                <th>#</th>
                <th>Spelare</th>
                <th>Serie 1</th>
                <th>Serie 2</th>
                <th>Serie 3</th>
                <th>Serie 4</th>
                <th>Bordpoäng</th>
            </tr>
            @for (var i = 0; i < Model.Players.Length; i++)
            {
                <tr>
                    <td>@(i + 1)@(i == 8 ? " (reserv)" : "")</td>
                    <td>
                        @Html.DropDownListFor(
                            m => m.Players[i].PlayerId,
                            playerListItems,
                            "Välj spelare",
                            new { @class = "span2" })
                    </td>
                    @for (var s = 0; s < 4; s++)
                    {
                        <td>
                            @Html.TextBoxFor(
                                m => m.Players[i].Games[s].Pins,
                                new
                                {
                                    @class = "span1",
                                    type = "number",
                                    pattern = @"\d*",
                                    min = "0",
                                    max = "300"
                                })
                        </td>
                    }
                    <td>
                        @Html.TextBoxFor(
                            m => m.Players[i].TableWins,
                            new
                            {
                                @class = "span1",
                                type = "number",
                                pattern = @"\d*",
                                min = "0",
                                max = "4"
                            })
                    </td>
                </tr>
            }
        </table>
    </div>
</div>
