@model Snittlistan.Web.Areas.V2.Controllers.MatchResultAdminController.RegisterMatchViewModel.PostModel
@{
    var playerListItems = (SelectListItem[])ViewData["PlayerListItems"];
}

<div class="row">
    <div class="span2">
        <div class="control-group">
            <div class="controls">
                @Html.LabelFor(
                    x => x.TeamScore,
                    new
                    {
                        @class = "control-label"
                    })
                @Html.TextBoxFor(
                    x => x.TeamScore,
                    new
                    {
                        @class = "span1",
                        type = "number",
                        pattern = @"\d*",
                        min = "0",
                        max = "20",
                        required = "required",
                        title = "0-20 poäng",
                        placeholder = "0-20"
                    })
            </div>
        </div>
    </div>
    <div class="span2">
        <div class="control-group">
            <div class="controls">
                @Html.LabelFor(
                    x => x.OpponentScore,
                    new
                    {
                        @class = "control-label"
                    })
                @Html.TextBoxFor(
                    x => x.OpponentScore,
                    new
                    {
                        @class = "span1",
                        type = "number",
                        pattern = @"\d*",
                        min = "0",
                        max = "20",
                        required = "required",
                        title = "0-20 poäng",
                        placeholder = "0-20"
                    })
            </div>
        </div>
    </div>
    <div class="span8">
        <div class="control-group">
            <div class="controls">
                @Html.LabelFor(
                    x => x.CommentaryDisplay,
                    new
                    {
                        @class = "control-label"
                    })
                <div data-quill>@Model.CommentaryDisplay</div>
            </div>
            @Html.HiddenFor(x => x.Commentary)
            @Html.HiddenFor(x => x.CommentaryHtml)
        </div>
    </div>
</div>
<div class="row">
    <div class="span12">
        <p>Namnen är förifyllda utifrån vilka som anmält sig till matchen. Byt spelare vid behov och fyll i resultatet för varje serie.</p>
        <table class="table table-condensed table-bordered table-striped">
            <tr>
                <th>Bord</th>
                <th>Spelare</th>
                <th>Serie 1</th>
                <th>Serie 2</th>
                <th>Serie 3</th>
                <th>Serie 4</th>
            </tr>
            @for (var t = 0; t < 4; t++)
            {
                for (var g = 0; g < 2; g++)
                {
                    var i = (t * 2) + g;
                    <tr>
                        @if (g == 0)
                        {
                            <td rowspan="2" style="vertical-align: middle;">@(t + 1)</td>
                        }
                        <td>
                            @Html.DropDownListFor(
                                m => m.Players[i].PlayerId,
                                playerListItems,
                                "Välj spelare",
                                new { @class = "span2", required = "required" })
                        </td>
                        @for (var s = 0; s < 4; s++)
                        {
                            <td>
                                @Html.TextBoxFor(
                                    m => m.Players[i].Games[s].Pins,
                                    new
                                    {
                                        @class = "span1",
                                        type = "number",
                                        pattern = @"\d*",
                                        min = "0",
                                        max = "300",
                                        required = "required"
                                    })
                            </td>
                        }
                    </tr>
                }
            }
        </table>
    </div>
</div>
<div class="row">
    <div class="span12">
        <p>Ange vilket bord som vann respektive serie.</p>
        <table class="table table-condensed table-bordered table-striped">
            <tr>
                <th>Bord</th>
                <th>Serie 1</th>
                <th>Serie 2</th>
                <th>Serie 3</th>
                <th>Serie 4</th>
            </tr>
            @for (var t = 0; t < 4; t++)
            {
                <tr>
                    <td>@(t + 1)</td>
                    @for (var s = 0; s < 4; s++)
                    {
                        <td>
                            <label>
                                @Html.CheckBoxFor(m => m.Wins[t].Won[s])
                                Vann
                            </label>
                        </td>
                    }
                </tr>
            }
        </table>
    </div>
</div>
